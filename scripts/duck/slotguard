#!/bin/bash
# Load gate for training launches (workflow finding: 5-10x in quiet window, verified).
# Quiet = 1-min load below threshold (default 12 on 8 cores) AND fewer than
# MAX_RUNNABLE runnable kernel threads. Usage: slotguard [max_load_1min]
CORES=$(sysctl -n hw.ncpu)
THRESHOLD="${1:-$((CORES * 3 / 2))}"
LOAD=$(uptime | sed -E 's/.*load averages?: ([0-9.]+).*/\1/')
RUNNABLE=$(ps axo state | grep -c "^[RU]")
if awk "BEGIN{exit !($LOAD >= $THRESHOLD)}"; then
  echo "slotguard: BUSY (load $LOAD >= $THRESHOLD, runnable $RUNNABLE) — wait for a quiet window"
  exit 42
fi
echo "slotguard: QUIET (load $LOAD < $THRESHOLD, runnable $RUNNABLE) — go"
exit 0
